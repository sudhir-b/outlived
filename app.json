{
  "expo": {
    "name": "Outlasted",
    "slug": "outlasted",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sudhirb.outlasted",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#59191F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sudhirb.outlasted",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      ["expo-notifications", { "icon": "./assets/notification-icon.png", "color": "#9F1930" }],
      "expo-font",
      ["expo-splash-screen", { "image": "./assets/splash-icon.png", "imageWidth": 200, "backgroundColor": "#59191F" }],
      ["./plugins/withAndroidAccent", { "color": "#FFFFFF" }]
    ],
    "scheme": "outlasted",
    "backgroundColor": "#59191F",
    "extra": {
      "eas": {
        "projectId": "352bbf38-fdac-4c38-ae40-45d731d49232"
      }
    },
    "owner": "sudb"
  }
}
